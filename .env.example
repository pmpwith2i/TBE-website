# Supabase
# Project URL from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Resend
RESEND_API_KEY=re_your_key

# Sender must use a domain/sender verified in Resend.
EVENT_REGISTRATION_EMAIL_FROM="Teramo Bike Experience <iscrizioni@your-domain.it>"

# One or more notification recipients. Separate multiple emails with commas.
EVENT_REGISTRATION_EMAIL_TO=federico.pomponii@gmail.com
